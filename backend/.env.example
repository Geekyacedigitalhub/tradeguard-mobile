# Required. Postgres connection string used by every backend request.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required. Signs TradeGuard session tokens and derives the cTrader token
# encryption key. Keep this value stable across deployments: changing it makes
# previously stored cTrader OAuth tokens unreadable.
JWT_SECRET=

# cTrader Open API application credentials.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Must match the redirect URI registered in the cTrader Open API dashboard.
CTRADER_REDIRECT_URI=https://tradeguard-api.fastapicloud.dev/v1/ctrader/oauth/callback

# Optional. Shared secret for the scheduled cloud market-data sync endpoint
# (`/v1/internal/cloud-market-sync`). The endpoint rejects every request when
# this is unset.
TRADEGUARD_CRON_SECRET=

# Optional. Shared secret for the legacy MT5 bridge. A cTrader-only deployment
# can leave this empty.
MT5_BRIDGE_SECRET=
